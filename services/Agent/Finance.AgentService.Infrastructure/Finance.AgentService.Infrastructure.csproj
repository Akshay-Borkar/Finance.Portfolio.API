<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <!-- 1.71.0 is the lowest version clearing GHSA-2ww3-72rp-wpp4 (critical), which affects
         Microsoft.SemanticKernel.Core through 1.70.0. Deliberately not 1.80.x: that removes
         AgentGroupChat/TerminationStrategy and ITextEmbeddingGenerationService, which this code
         still uses, and there are no tests or Azure OpenAI credentials here to verify a rewrite
         against. Treat the 1.8x migration as its own task. -->
    <PackageReference Include="Microsoft.SemanticKernel" Version="1.71.0" />
    <PackageReference Include="Microsoft.SemanticKernel.Agents.Core" Version="1.71.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\shared\Finance.Contracts\Finance.Contracts.csproj" />
    <ProjectReference Include="..\..\..\shared\Finance.SharedKernel.Messaging\Finance.SharedKernel.Messaging.csproj" />
  </ItemGroup>

</Project>
