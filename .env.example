# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real secrets.

# JWT
JWT_SECRET=your-very-long-secret-key-at-least-32-characters-here
JWT_ISSUER=FinanceStockMarket.Api
JWT_AUDIENCE=FinanceStockMarketUser
JWT_DURATION_MINUTES=60

# SQL Server (Docker service name or hostname)
SQL_SERVER=sqlserver
SQL_PASSWORD=YourStrong!Passw0rd

# Redis
REDIS_CONNECTION=redis:6379

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_USERNAME=finance
RABBITMQ_PASSWORD=Finance@123

# SendGrid
SENDGRID_API_KEY=SG.xxx
SENDGRID_FROM_ADDRESS=alerts@yourapp.com
SENDGRID_FROM_NAME=Finance Portfolio Alerts

# Microsoft Entra External ID (Azure AD) — optional. Leave blank to keep the
# EntraExternalId auth scheme disabled entirely (existing username/password
# login is unaffected either way). Fill in once the Entra External ID tenant
# and API app registration exist (see Phase 0 of the Azure AD plan).
AZURE_AD_INSTANCE=
AZURE_AD_TENANT_ID=
AZURE_AD_AUDIENCE=
