root = true

# ──────────────────────────────────────────────────────────────────────────────────────────
# Baseline for every file
# ──────────────────────────────────────────────────────────────────────────────────────────
[*]
charset = utf-8
end_of_line = crlf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{json,yml,yaml,csproj,props,targets,slnx}]
indent_size = 2

[*.{feature,md}]
trim_trailing_whitespace = false

# ──────────────────────────────────────────────────────────────────────────────────────────
# C#
#
# These rules describe the style this codebase already uses rather than imposing a new one:
# every namespace is file-scoped (199 of 199), every private readonly field is _camelCase
# (150 of 150), and var is the default for locals. Anything measured as unanimous is set to
# warning, because there is nothing to churn. Anything the codebase is genuinely mixed on is
# left at suggestion, so it shows in the IDE without failing a build.
# ──────────────────────────────────────────────────────────────────────────────────────────
[*.cs]

# ── The rule this file mainly exists for ──────────────────────────────────────────────────
# Unused usings. Nothing surfaced these before: the compiler does not warn, and no analyzer
# was enabled. Needs GenerateDocumentationFile, which Directory.Build.props turns on.
dotnet_diagnostic.IDE0005.severity = warning

# ── Layout ────────────────────────────────────────────────────────────────────────────────
csharp_style_namespace_declarations = file_scoped:warning
csharp_using_directive_placement = outside_namespace:warning
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_new_line_before_members_in_object_initializers = true
csharp_indent_case_contents = true
csharp_indent_switch_labels = true
csharp_space_after_keywords_in_control_flow_statements = true
csharp_preserve_single_line_blocks = true

# Mixed in practice -- System-first is common but not universal, so this informs rather than nags.
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# ── Language style ────────────────────────────────────────────────────────────────────────
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion

csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_expression_bodied_accessors = true:suggestion
csharp_style_expression_bodied_constructors = false:suggestion

csharp_prefer_braces = when_multiline:suggestion
csharp_style_prefer_switch_expression = true:suggestion
csharp_style_prefer_pattern_matching = true:suggestion
csharp_style_prefer_not_pattern = true:suggestion
csharp_style_throw_expression = true:suggestion
csharp_style_inlined_variable_declaration = true:suggestion
csharp_prefer_simple_using_statement = true:suggestion
csharp_style_prefer_primary_constructors = false:silent

dotnet_style_object_initializer = true:suggestion
dotnet_style_collection_initializer = true:suggestion
dotnet_style_prefer_conditional_expression_over_assignment = true:silent
dotnet_style_prefer_conditional_expression_over_return = true:silent
dotnet_style_null_propagation = true:suggestion
dotnet_style_coalesce_expression = true:suggestion
dotnet_style_readonly_field = true:suggestion

# `this.` is never used here.
dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method = false:warning
dotnet_style_qualification_for_event = false:warning

dotnet_style_predefined_type_for_locals_parameters_members = true:warning
dotnet_style_predefined_type_for_member_access = true:warning

# ── Naming ────────────────────────────────────────────────────────────────────────────────
dotnet_naming_style.pascal_case.capitalization = pascal_case
dotnet_naming_style.camel_case.capitalization = camel_case
dotnet_naming_style.underscore_camel_case.capitalization = camel_case
dotnet_naming_style.underscore_camel_case.required_prefix = _
dotnet_naming_style.interface_prefixed_with_i.capitalization = pascal_case
dotnet_naming_style.interface_prefixed_with_i.required_prefix = I

dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_symbols.private_fields.required_modifiers =

dotnet_naming_symbols.constants.applicable_kinds = field
dotnet_naming_symbols.constants.required_modifiers = const

dotnet_naming_symbols.interfaces.applicable_kinds = interface

dotnet_naming_symbols.public_members.applicable_kinds = property,method,event,namespace,class,struct,enum,delegate
dotnet_naming_symbols.public_members.applicable_accessibilities = public,internal,protected,protected_internal

dotnet_naming_symbols.parameters_and_locals.applicable_kinds = parameter,local

# const wins over the private-field rule, so it is declared first.
dotnet_naming_rule.constants_are_pascal_case.symbols = constants
dotnet_naming_rule.constants_are_pascal_case.style = pascal_case
dotnet_naming_rule.constants_are_pascal_case.severity = warning

dotnet_naming_rule.private_fields_are_underscore_camel_case.symbols = private_fields
dotnet_naming_rule.private_fields_are_underscore_camel_case.style = underscore_camel_case
dotnet_naming_rule.private_fields_are_underscore_camel_case.severity = warning

dotnet_naming_rule.interfaces_start_with_i.symbols = interfaces
dotnet_naming_rule.interfaces_start_with_i.style = interface_prefixed_with_i
dotnet_naming_rule.interfaces_start_with_i.severity = warning

dotnet_naming_rule.public_members_are_pascal_case.symbols = public_members
dotnet_naming_rule.public_members_are_pascal_case.style = pascal_case
dotnet_naming_rule.public_members_are_pascal_case.severity = warning

dotnet_naming_rule.parameters_and_locals_are_camel_case.symbols = parameters_and_locals
dotnet_naming_rule.parameters_and_locals_are_camel_case.style = camel_case
dotnet_naming_rule.parameters_and_locals_are_camel_case.severity = suggestion

# ──────────────────────────────────────────────────────────────────────────────────────────
# Generated and vendored code
# ──────────────────────────────────────────────────────────────────────────────────────────

# EF scaffolds these and rewrites them on every `migrations add`; style rules would fight the tool.
[**/Migrations/*.cs]
generated_code = true
dotnet_analyzer_diagnostic.severity = none

# Reqnroll regenerates *.feature.cs from the .feature files at build time.
[**/*.feature.cs]
generated_code = true
dotnet_analyzer_diagnostic.severity = none

# Generated from marketdata.proto by Grpc.Tools.
[**/Protos/**]
generated_code = true
